# Reown / WalletConnect Project ID (Get one free at https://cloud.reown.com/)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_PROJECT_ID

# GitHub Pages project-site subpath (for example /repo). Leave empty for a
# custom domain at the root. Must match the BASE_PATH used by next.config.ts.
BASE_PATH=

# Optional keyed Sepolia RPC (e.g. Alchemy). It ships to the browser, so restrict the key to your domains.
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Smart Contract Addresses
# Defaults to official Sepolia v0.0.6 deployment if left empty:
# IdentitySystem: 0x15253A56CD3EbC2893914C2139094dc92a42c016
# ProfileSystem:  0x17dc6AA09432d61ca630b523DAF01fB2b98Bd58D
NEXT_PUBLIC_IDENTITY_SYSTEM_ADDRESS=0x15253A56CD3EbC2893914C2139094dc92a42c016
NEXT_PUBLIC_PROFILE_SYSTEM_ADDRESS=0x17dc6AA09432d61ca630b523DAF01fB2b98Bd58D

# Local Development on Anvil (Chain ID 31337):
# When running a local Anvil node and deploying contracts locally via `make deploy-anvil`,
# uncomment and use the deterministic deployed addresses below:
# NEXT_PUBLIC_IDENTITY_SYSTEM_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# NEXT_PUBLIC_PROFILE_SYSTEM_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# Optional Cloudflare Web Analytics site token (Cloudflare dashboard > Web Analytics > Manage site).
# It is public by design (shipped in page HTML), but keep it in env so forks and local dev don't
# send data to the production site. Leave empty to disable analytics. Never use an API token here.
NEXT_PUBLIC_CF_BEACON_TOKEN=
